# AutoMarts - Environment Configuration
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development

# Server
PORT=8000
HOST=0.0.0.0

# Database
DB_PATH=./backend/automarts.db

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# Token lifetime (seconds) - 7 days default
TOKEN_TTL=604800

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Delivery (PKR)
DELIVERY_CHARGE_PKR=250
FREE_DELIVERY_THRESHOLD_PKR=5000

# Admin (set secure password in production!)
ADMIN_EMAIL=admin@automarts.pk
ADMIN_PASSWORD=changeme123

# Payment - only COD available without external provider
PAYMENT_PROVIDER=cod
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Supabase (for OAuth + live DB)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key