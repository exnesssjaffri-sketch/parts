{
  "name": "automarts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --host",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview",
    "db:init": "tsx backend/src/db/init.ts",
    "db:seed": "tsx backend/src/db/seed.ts",
    "db:reset": "npm run db:init && npm run db:seed",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4.3.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "lucide-react": "^1.61.0",
    "otpauth": "^9.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.15.1",
    "typescript-eslint": "^8.72.1",
    "zod": "^3.23.8"
  }
}
