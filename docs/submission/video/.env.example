# AutoMarts 4K Voiceover Showcase - Video Pipeline Environment Variables
# Copy this file to .env and fill in your values

# LLMAPI Gateway Configuration
LLMAPI_BASE_URL=http://127.0.0.1:31415/v1
LLMAPI_API_KEY=sk-placeholder-key

# TTS Configuration
TTS_MODEL=auto
TTS_VOICE=onyx
TTS_FORMAT=wav
TTS_SPEED=1.0

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Source Video Clips Directory (relative to project root)
SOURCE_CLIPS_DIR=docs/submission/video/assets/source_clips

# Voiceover Audio Output Directory (relative to project root)
VOICEOVER_OUTPUT_DIR=docs/submission/video/assets/voiceover

# Mixed Audio+Video Output Directory (relative to project root)
MIXED_OUTPUT_DIR=docs/submission/video/assets/mixed

# Final Render Output Directory (relative to project root)
FINAL_OUTPUT_DIR=docs/submission/video/assets/final

# Project Root (for absolute path resolution)
PROJECT_ROOT=.